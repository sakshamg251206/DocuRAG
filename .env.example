# Copy to `.env` and adjust as needed. Every value shown is the default, so the file is optional.
# The API reads `.env` from the directory it is started in; `make` also exports it to the UI.

# ── Language model (Ollama) ──────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
# Lower = more deterministic, factual answers.
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=300

# ── Retrieval ────────────────────────────────────────────────────────────────
# Changing the embedding model makes previously indexed documents unusable (they are skipped
# on startup and must be uploaded again).
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# Passages given to the LLM per question, chosen from RETRIEVAL_FETCH_K candidates.
RETRIEVAL_K=5
RETRIEVAL_FETCH_K=20
# Previous chat messages sent along with each question (for follow-ups).
HISTORY_TURNS=6

# ── Uploads & storage ────────────────────────────────────────────────────────
MAX_PDF_SIZE_MB=50
DATA_DIR=data
PERSIST_DOCUMENTS=true

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:8501
LOG_LEVEL=INFO

# ── Web UI ───────────────────────────────────────────────────────────────────
DOCURAG_API_URL=http://localhost:8000
